+/// See BlockCache::get_overwrite.
+pub fn getblk_overwrite(device: *const crate::drivers::blkdev::GenDisk, blocknr: u64) -> Option<*mut BufferHead> {
+    get_block_cache().get_overwrite(device, blocknr)
