# Generated by Cargo
# will have compiled files and executables
debug/
target/
refer/

# Mini-ltp test output
userspace/tests/mini-ltp/output/

# Linux-LTP test suite
userspace/linux-ltp/output/
userspace/linux-ltp/ltp-full-*/

# musl build artifacts
toolchain/musl-*/
toolchain/riscv64-rux-linux-musl/

# These files generated by Claude Code
.claude/

# These are backup files generated by rustfmt
**/*.rs.bk
*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# =====================
# Rux Kernel Specific
# =====================

# Temporary files and logs
*.log
serial.log
*.dtb/*.bin
kernel.bin
*.dtb

# QEMU and debug files
*.gdb
gdb.txt
/virt.dtb
/debug_qemu.gdb

# Test temporary files
/tmp/gdb*.txt
/tmp/qemu*.txt

# Editor temporary files
*~
*.swp
*.swo
.vscode/
.idea/

# Backup files
*.bak
*.backup
*_backup.*

# Disk image files
*.img
disk.img
# Build configuration
build/.config
build/.config.bak
**/.cargo/

# Userspace compiled binaries
userspace/shell/shell
userspace/toybox/toybox/toybox
