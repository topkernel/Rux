#!/bin/bash
#
# Rux User Programs Build Script
#
# Usage:
#   ./build.sh           - Build all user programs (debug)
#   ./build.sh release   - Build all user programs (release)
#   ./build.sh clean     - Clean build artifacts

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# Backup root directory's cargo config (if exists)
CARGO_CONFIG="$ROOT_DIR/.cargo/config.toml"
BACKUP_CONFIG="$ROOT_DIR/.cargo/config.toml.backup"

disable_root_config() {
    if [ -f "$CARGO_CONFIG" ] && [ ! -f "$CARGO_CONFIG.disabled" ]; then
        info "Backing up root directory's cargo config..."
        cp "$CARGO_CONFIG" "$BACKUP_CONFIG"
        mv "$CARGO_CONFIG" "$CARGO_CONFIG.disabled"
    fi
}

restore_root_config() {
    if [ -f "$BACKUP_CONFIG" ]; then
        info "Restoring root directory's cargo config..."
        mv "$CARGO_CONFIG.disabled" "$CARGO_CONFIG"
        rm -f "$BACKUP_CONFIG"
    fi
}

# Cleanup function
cleanup() {
    restore_root_config
}

# Set trap to ensure cleanup
trap cleanup EXIT

# Clean build
clean_build() {
    info "Cleaning user program build artifacts..."
    cd "$SCRIPT_DIR"
    cargo clean
    info "Clean complete"
}

# Build user programs
build_userspace() {
    local MODE="${1:-debug}"
    local RELEASE_FLAG=""

    if [ "$MODE" = "release" ]; then
        RELEASE_FLAG="--release"
        info "Building user programs (release mode)..."
    else
        info "Building user programs (debug mode)..."
    fi

    # Disable root directory's cargo config
    disable_root_config

    # Enter user programs directory
    cd "$SCRIPT_DIR"

    # Build all user programs
    # GUI library
    info "Compiling rux_gui library..."
    cargo build $RELEASE_FLAG -p rux_gui

    # GUI applications (apps/)
    info "Compiling desktop..."
    cargo build $RELEASE_FLAG -p desktop

    info "Compiling calculator..."
    cargo build $RELEASE_FLAG -p calculator

    info "Compiling clock..."
    cargo build $RELEASE_FLAG -p clock

    info "Compiling vshell..."
    cargo build $RELEASE_FLAG -p vshell

    # Test programs (tests/)
    info "Compiling smoke_test..."
    cargo build $RELEASE_FLAG -p smoke_test

    # Display output files
    echo ""
    info "Build complete! Output files:"

    local TARGET_DIR="target/riscv64gc-unknown-linux-musl/debug"
    if [ "$MODE" = "release" ]; then
        TARGET_DIR="target/riscv64gc-unknown-linux-musl/release"
    fi

    # List generated executables
    echo ""
    info "GUI applications (apps/ -> /app/):"
    for bin in desktop calculator clock vshell; do
        local bin_path="$TARGET_DIR/$bin"
        if [ -f "$bin_path" ]; then
            local size=$(stat -c%s "$bin_path" 2>/dev/null || stat -f%z "$bin_path" 2>/dev/null)
            echo "  $bin: $size bytes"
        fi
    done

    # Test programs
    echo ""
    info "Test programs (tests/ -> /test/):"
    for bin in smoke_test; do
        local bin_path="$TARGET_DIR/$bin"
        if [ -f "$bin_path" ]; then
            local size=$(stat -c%s "$bin_path" 2>/dev/null || stat -f%z "$bin_path" 2>/dev/null)
            echo "  $bin: $size bytes"
        fi
    done



    echo ""
    info "User programs built successfully!"
}

# Main function
main() {
    local COMMAND="${1:-build}"

    case "$COMMAND" in
        clean)
            clean_build
            ;;
        release)
            build_userspace release
            ;;
        build|debug|"")
            build_userspace debug
            ;;
        *)
            error "Unknown command: $COMMAND"
            echo "Usage: $0 [build|release|clean]"
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
